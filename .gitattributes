# Скрипты и файлы для сервера — всегда с переводом строки LF, даже при checkout на Windows
# (иначе bash на сервере: «/usr/bin/env: ‘bash\r’: No such file or directory»)
*.sh            text eol=lf
deploy/**       text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
